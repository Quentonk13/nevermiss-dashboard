{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "environmentVariables": {
      "TWILIO_ACCOUNT_SID": "",
      "TWILIO_AUTH_TOKEN": "",
      "TWILIO_PHONE_NUMBER": "",
      "REPLY_MESSAGE": "Thanks for calling! We'll text you back shortly. - NeverMiss"
    }
  }
}